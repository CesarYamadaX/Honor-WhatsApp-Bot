# URL del servicio Python (sql_agent/api.py). Debe apuntar a loopback: ese
# servicio no tiene autenticacion propia.
AGENT_API_URL=http://127.0.0.1:8000

# Tamano maximo, en MB, de un archivo Excel que el sidecar intenta enviar por
# WhatsApp. Por encima de este limite se avisa al usuario y no se manda nada.
MAX_FILE_MB=16
