# Conexion a SQL Server.
# IMPORTANTE: este usuario debe tener SOLO permisos de lectura (db_datareader).
# El bot nunca escribe, y un login restringido es la unica garantia real de
# solo-lectura: las reglas del prompt el modelo las puede desobedecer.
DB_URI=mssql+pyodbc://usuario_lectura:password@192.168.1.50/GTM_Honor_Mexico?driver=ODBC+Driver+18+for+SQL+Server

# Modelo de lenguaje (OpenRouter).
OPENROUTER_API_KEY=sk-or-v1-reemplazar
OPENROUTER_MODEL=openai/gpt-4-turbo-preview

# Numeros autorizados, en formato internacional sin signos, separados por coma.
# Sin esta variable el servicio NO arranca: es lo unico que impide que
# cualquiera que descubra el numero consulte la base de la empresa.
WHATSAPP_ALLOWED_NUMBERS=5215512345678,5215587654321

# Limites.
AGENT_TIMEOUT_SECONDS=90
SESSION_TTL_MINUTES=60

# Cuanto espera un mensaje nuevo a que la consulta anterior del mismo chat se
# de por cancelada. En la practica tarda segundos; este plazo cubre el caso en
# que la consulta vieja este dentro de una llamada al modelo, que no se puede
# interrumpir. Pasado el plazo, el mensaje nuevo recibe un 429.
#
# OJO al subirlo: el sidecar de Node abandona la peticion a los 180s
# (TIMEOUT_MS_DEFAULT en agentClient.js), y el peor caso es este valor MAS
# AGENT_TIMEOUT_SECONDS. Si la suma pasa de 180, el sidecar cortara peticiones
# que todavia iban a responder.
CANCEL_WAIT_SECONDS=60

# Directorio donde se escriben los reportes Excel generados por
# consultar_sql. Opcional: si no se define, el default es "exports" junto a
# excel_exporter.py, NO el cwd desde el que se arranco Python. La ruta que
# devuelve export_to_excel() siempre se normaliza a absoluta antes de viajar
# por HTTP al sidecar de Node (ver "El contrato HTTP" en el spec) -- ambos
# procesos corren en la misma maquina pero no comparten cwd. Si se define
# esta variable con una ruta relativa, esa ruta se resuelve contra el cwd de
# Python en el momento de exportar; para evitar sorpresas, usa una ruta
# absoluta, por ejemplo /home/usuario/sql_agent/exports.
#
# Va comentada a proposito: el default ya es correcto, y una ruta de ejemplo
# copiada tal cual no falla al arrancar -- el exportador hace makedirs y los
# reportes se escriben durante semanas en un directorio inventado sin que
# nadie se entere. Descomentala solo si de verdad los quieres en otro lado.
# EXPORT_DIR=/home/usuario/sql_agent/exports

# El endpoint /ask no tiene autenticacion: su unica defensa es el loopback.
# Nunca poner 0.0.0.0 aqui.
API_HOST=127.0.0.1
API_PORT=8000
